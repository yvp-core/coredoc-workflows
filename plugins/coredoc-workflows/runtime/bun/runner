#!/bin/sh
set -eu

runner=$0
case "$runner" in
  /*) ;;
  *) runner=$PWD/$runner ;;
esac
runtime_dir=${runner%/*}
bun=$runtime_dir/darwin-arm64/bun
config=$runtime_dir/bunfig.toml

if [ ! -x "$bun" ] || [ ! -r "$config" ]; then
  echo "coredoc-workflows: installed bundled runtime is incomplete" >&2
  exit 70
fi

unset BUN_OPTIONS
unset BUN_INSPECT
unset BUN_INSPECT_CONNECT_TO
unset BUN_INSPECT_NOTIFY
unset BUN_INSPECT_PRELOAD
unset BUN_JS_DEBUG
unset BUN_CONFIG_VERBOSE_FETCH
unset NODE_OPTIONS
export DO_NOT_TRACK=1
export BUN_RUNTIME_TRANSPILER_CACHE_PATH=0

exec "$bun" --no-env-file --no-install --config="$config" "$@"
