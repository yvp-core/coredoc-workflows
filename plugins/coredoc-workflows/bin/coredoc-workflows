#!/bin/sh
set -eu

if [ "$#" -eq 0 ]; then
  echo "usage: coredoc-workflows <command> [args...]" >&2
  exit 64
fi

command_name=$1
shift

launcher=$0
case "$launcher" in
  /*) ;;
  *) launcher=$PWD/$launcher ;;
esac
bin_dir=${launcher%/*}
plugin_root=${bin_dir%/*}

platform=$(/usr/bin/uname -s)
architecture=$(/usr/bin/uname -m)
if [ "$platform" != "Darwin" ] || [ "$architecture" != "arm64" ]; then
  echo "coredoc-workflows: bundled runtime supports macOS on Apple silicon only (found $platform/$architecture)" >&2
  exit 69
fi

bun=$plugin_root/runtime/bun/darwin-arm64/bun
config=$plugin_root/runtime/bun/bunfig.toml
if [ ! -x "$bun" ]; then
  echo "coredoc-workflows: bundled runtime is missing or not executable" >&2
  exit 70
fi

# Do not let ambient Bun/Node flags inject code, load project .env files, install
# packages, emit telemetry, or persist a transpiler cache from trusted hooks.
unset BUN_OPTIONS
unset BUN_INSPECT_PRELOAD
unset BUN_CONFIG_VERBOSE_FETCH
unset NODE_OPTIONS
export DO_NOT_TRACK=1
export BUN_RUNTIME_TRANSPILER_CACHE_PATH=0

resolve_capture_node() {
  node_bin=$(command -v node 2>/dev/null || true)
  case "$node_bin" in
    /*) ;;
    *)
      echo "coredoc-workflows: capture agent requires Node.js 22 or newer on PATH" >&2
      exit 69
      ;;
  esac
  if [ ! -x "$node_bin" ]; then
    echo "coredoc-workflows: capture agent requires Node.js 22 or newer on PATH" >&2
    exit 69
  fi
  node_major=$("$node_bin" -p 'process.versions.node.split(".")[0]' 2>/dev/null || true)
  node_runtime=$("$node_bin" -p 'process.versions.bun ? "bun" : "node"' 2>/dev/null || true)
  case "$node_major" in
    ''|*[!0-9]*)
      echo "coredoc-workflows: unable to determine the installed Node.js version" >&2
      exit 69
      ;;
  esac
  if [ "$node_major" -lt 22 ]; then
    echo "coredoc-workflows: capture agent requires Node.js 22 or newer (found $node_major)" >&2
    exit 69
  fi
  if [ "$node_runtime" != "node" ]; then
    echo "coredoc-workflows: capture agent requires Node.js 22 or newer; Bun cannot own the persistent LaunchAgent" >&2
    exit 69
  fi
}

case "$command_name" in
  artifact-checkpoints) target=scripts/artifact-checkpoints.mjs ;;
  browse) target=runtime/browse/browse.mjs ;;
  build-skills) target=scripts/build-skills.mjs ;;
  capture)
    case "${1:-}" in
      setup|status|doctor|repair|upgrade|disable|uninstall)
        target=scripts/capture-agent-setup.mjs
        capture_node_required=1
        ;;
      *) target=runtime/capture/cli.mjs ;;
    esac
    ;;
  capture-health) target=scripts/capture-health-report.mjs ;;
  claude-peer) target=skills/coredoc-claude/scripts/run.mjs ;;
  codex-peer) target=skills/coredoc-codex/scripts/run.mjs ;;
  coredoc-desktop) target=runtime/desktop/coredoc.mjs ;;
  electron-qa) target=runtime/desktop/desktop.mjs ;;
  ensure-managed-relay) target=scripts/ensure-managed-relay.mjs ;;
  finish-run) target=scripts/finish-run.mjs ;;
  managed-relay) target=scripts/managed-otel-relay.mjs ;;
  native-otel-sanitize) target=scripts/native-otel-sanitizer.mjs ;;
  project-key) target=scripts/project-key.mjs ;;
  redact-scan) target=scripts/redact-scan.mjs ;;
  retry-pending) target=scripts/retry-pending.mjs ;;
  retro-evidence) target=scripts/retro-evidence.mjs ;;
  route-task) target=scripts/route-task.mjs ;;
  session-end) target=scripts/session-end.mjs ;;
  session-env) target=scripts/session-env.mjs ;;
  stage-run) target=scripts/stage-run.mjs ;;
  workflow-observer) target=scripts/workflow-observer.mjs ;;
  test)
    # Capture-agent commands are executed by system Node.js 22+, not Bun. The
    # Bun half excludes their tests; the Node half below runs them explicitly.
    "$bun" --no-env-file --no-install --config="$config" test \
      --path-ignore-patterns='**/capture-agent-*.test.mjs' \
      "$plugin_root/scripts" \
      "$plugin_root/runtime/browse" \
      "$plugin_root/runtime/capture" \
      "$plugin_root/runtime/desktop" "$@"
    resolve_capture_node
    exec "$node_bin" --test "$plugin_root"/scripts/capture-agent-*.test.mjs
    ;;
  version)
    exec "$bun" --version
    ;;
  *)
    echo "coredoc-workflows: unknown command: $command_name" >&2
    exit 64
    ;;
esac

if [ "${capture_node_required:-0}" -eq 1 ]; then
  resolve_capture_node
  exec "$node_bin" "$plugin_root/$target" "$@"
fi

exec "$bun" --no-env-file --no-install --config="$config" "$plugin_root/$target" "$@"
